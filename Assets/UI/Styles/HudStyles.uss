.stat-box {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: rgba(30, 30, 30, 0.8);
    border-radius: 9px;
    padding: 6px 12px;
    height: 36px;
    margin: 8px;
    padding-left: 6px;
    padding-right: 4px;
}

.hud-text {
    color: white;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    margin-left: 8px;
    margin-right: 8px;
    padding: 0;
}

.spacer-right {
    margin-right: 30px;
}

.icon-time {
    margin-right: 0;
    background-image: url("project://database/Assets/UI/Sprites/day-icon.png?fileID=2800000&guid=3043c45a47d55e14c89252b240482950&type=3#day-icon");
    -unity-background-scale-mode: scale-to-fit;
    width: 24px;
    height: 24px;
    background-position-x: center;
    background-size: contain;
}

.speed-btn {
    width: 36px;
    height: 24px;
    background-color: rgb(85, 85, 85);
    color: white;
    border-radius: 4px;
    margin-left: 2px;
    border-width: 0;
    font-size: 14px;
    padding: 0;
}

.speed-btn:hover {
    background-color: rgb(119, 119, 119);
}

.speed-btn:active {
    background-color: rgb(153, 153, 153);
}

.speed-btn.selected {
    background-color: rgb(88, 111, 117);
    color: white;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.5);
}

.btn-pause {
    -unity-background-scale-mode: scale-to-fit;
    background-size: 14px 14px;
    background-position: center;
    background-repeat: no-repeat;
    background-image: url("project://database/Assets/UI/Sprites/pause-button.png?fileID=2800000&guid=20bed39dec8782f45bc88c6975fb0d15&type=3#pause-button");
}
