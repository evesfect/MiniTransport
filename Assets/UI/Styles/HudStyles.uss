:root {
    /* 1. Global Opacity Settings (0.9 = 90%) */
    
    /* Panels */
    --color-panel-bg:       rgba(30, 30, 30, 0.9);
    --color-dropdown-bg:    rgba(25, 25, 25, 0.9); 

    /* Buttons (Normal state is 90% opacity gray) */
    --color-btn-normal:     rgba(85, 85, 85, 0.9);
    
    /* Interactions */
    --color-btn-hover:      rgba(119, 119, 119, 0.9);
    --color-btn-pressed:    rgba(153, 153, 153, 0.9);
    
    /* The "Highlighted" Color (Green with 90% opacity) */
    --color-selected-green: rgba(111, 179, 114, 0.29);
    
    /* Text */
    --text-color-white:     rgb(255, 255, 255);
    
    /* Radius */
    --border-radius:        4px;
}

.stat-box {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: var(--color-panel-bg);
    border-radius: var(--border-radius);
    padding: 6px 12px;
    height: 36px;
    margin: 8px;
    padding-left: 6px;
    padding-right: 4px;
}

.hud-text {
    color: var(--text-color-white);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    margin-left: 8px;
    margin-right: 8px;
    padding: 0;
}

.spacer-right {
    margin-right: 30px;
}

.icon-time {
    margin-right: 0;
    background-image: url("project://database/Assets/UI/Sprites/day-icon.png?fileID=2800000&guid=3043c45a47d55e14c89252b240482950&type=3#day-icon");
    -unity-background-scale-mode: scale-to-fit;
    width: 24px;
    height: 24px;
    background-position: center;
}

/* --- SPEED BUTTONS --- */
.speed-btn {
    width: 36px;
    height: 24px;
    background-color: var(--color-btn-normal);
    color: var(--text-color-white);
    border-radius: 4px;
    margin-left: 2px;
    border-width: 0;
    font-size: 14px;
    padding: 0;
}

.speed-btn:hover {
    background-color: var(--color-btn-hover);
}

.speed-btn:active {
    background-color: var(--color-btn-pressed);
}

/* Selected Speed Button -> Green */
.speed-btn.selected {
    background-color: var(--color-selected-green);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.5);
}

.btn-pause {
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/UI/Sprites/pause-button.png?fileID=2800000&guid=20bed39dec8782f45bc88c6975fb0d15&type=3#pause-button");
    background-size: 14px 14px;
    background-position: center;
    background-repeat: no-repeat;
}

.inspection-btn {
    width: 42px;
    height: 42px;
    background-color: var(--color-btn-normal); /* Default Gray */
    border-radius: var(--border-radius);
    border-width: 2px;
    border-color: rgba(199, 199, 199, 0.32);
    margin: 4px;
    background-image: url("project://database/Assets/UI/Sprites/chart.png?fileID=2800000&guid=cdda0b0763d436c4aa89c71ac83e0bca&type=3#chart");
    -unity-background-scale-mode: scale-to-fit;
    background-size: 36px 36px;
    background-position: center;
    background-repeat: no-repeat;
}

.inspection-btn:hover {
    background-color: var(--color-btn-hover);
}

/* Active Inspection Button -> Green (Matches Speed Buttons) */
.inspection-btn.active {
    background-color: var(--color-selected-green);
}

.dropdown-panel {
    position: absolute;
    background-color: var(--color-dropdown-bg);
    border-width: 2px;
    border-color: rgba(199, 199, 199, 0.32);
    border-radius: 3px;
    padding: 4px 0; 
    min-width: 160px;
    display: none;
    overflow: hidden; 
}

.menu-item {
    flex-direction: row;
    height: 40px;
    margin-bottom: 0;
    
    background-color: transparent;
    
    border-radius: 2px;
    border-width: 0;
    color: var(--text-color-white);
    font-size: 14px;
    -unity-text-align: middle-left;
    
    /* Spacing for Text */
    padding-left: 50px;
    padding-right: 12px;
    
    transition-property: background-color;
    transition-duration: 0.1s;

    /* This ensures any background image you add behaves like an icon */
    background-size: 30px 30px; 
    background-position: left 8px center;
    background-repeat: no-repeat;
}

.menu-item:hover {
    background-color: var(--color-btn-hover);
}

.menu-item.active {
    background-color: var(--color-selected-green);
    color: white;
}